# ------------------------------------------------------------
# Die Hofgeschichten – Umgebungsvariablen
# Bei Vercel unter: Project → Settings → Environment Variables
# NIE in Git einchecken. Lokal: Datei als .env.local kopieren.
# ------------------------------------------------------------

# Pflicht für Premium: Schlüssel zum Signieren der Freischaltung (mind. 32 Zeichen, zufällig)
# Erzeugen z. B. mit:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENTITLEMENT_SECRET=

# --- Freischaltung über Shopify-Bestellung (empfohlen) ---
# Die *.myshopify.com-Adresse des Shops (nicht die eigene Domain!)
SHOPIFY_STORE_DOMAIN=
# Variante A (Dev-Dashboard-App, seit 2026 Standard):
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Variante B (nur falls bereits eine ältere Custom App mit Admin-Token existiert):
SHOPIFY_ADMIN_TOKEN=
# Optional: Admin-API-Version (Standard 2026-07)
SHOPIFY_API_VERSION=
# Nur für den Testkauf vor dem Launch auf 1 setzen, danach wieder entfernen
SHOPIFY_ALLOW_TEST_ORDERS=

# --- Ersatzweg: Freischaltcodes (Geschenke, Support) ---
# Eigener Schlüssel, mind. 32 Zeichen. Gleicher Wert beim Erzeugen der Codes (npm run codes).
LICENSE_SECRET=
# Gesperrte Codes, kommagetrennt (z. B. bei Missbrauch)
REVOKED_CODES=
