{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "Horse & Harmonie",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "judgeme_preview_badge": {
          "type": "shopify://apps/judge-me-reviews/blocks/preview_badge/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "subscriptions_app_block_KjRnjE": {
          "type": "shopify://apps/subscriptions/blocks/app-block/a3bfe9ec-96f8-4508-a003-df608a36d2ad",
          "settings": {
            "widget_style": "button",
            "widget_style_card_selector": "radio_button",
            "subscription_policy_url": "",
            "color_text_body": "#6D7175",
            "dividers_color": "#8F8D8D",
            "background_color": "#FFFFFF",
            "border_thickness": 1,
            "border_radius": 0,
            "product": "{{product}}"
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Teilen"
          }
        },
        "hh_gift_upgrade": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'hh-gift-upgrade', product: product, section_id: section.id %}"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "judgeme_preview_badge",
        "price",
        "variant_picker",
        "hh_gift_upgrade",
        "quantity_selector",
        "buy_buttons",
        "subscriptions_app_block_KjRnjE",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "stacked",
        "media_position": "left",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 48,
        "padding_bottom": 36
      }
    },
    "judgeme_reviews": {
      "type": "apps",
      "blocks": {
        "judgeme_review_widget": {
          "type": "shopify://apps/judge-me-reviews/blocks/review_widget/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8",
          "settings": {}
        }
      },
      "block_order": [
        "judgeme_review_widget"
      ],
      "settings": {
        "include_margins": true
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Das könnte dir auch gefallen",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 64,
        "padding_bottom": 72
      }
    }
  },
  "order": [
    "main",
    "judgeme_reviews",
    "related-products"
  ]
}