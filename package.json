{
  "name": "hofgeschichten",
  "version": "0.1.0",
  "private": true,
  "description": "Die Hofgeschichten – Kinder-Web-App von Horse & Harmonie Kids Originals",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:akademie": "tsx scripts/check-akademie.ts",
    "codes": "node scripts/generate-codes.mjs",
    "voice:export": "tsx --conditions=react-server scripts/voice-export.ts",
    "voice:generate": "node scripts/voice-generate.mjs",
    "voice:manifest": "node scripts/voice-manifest.mjs",
    "support": "node scripts/support.mjs",
    "check:premium": "tsx --conditions=react-server scripts/check-premium.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0"
  }
}
